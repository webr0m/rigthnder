  "type": "module",
  "description": "OnlyFachos: comunidad con feed vertical, chat directo y citas de mutuo acuerdo.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node --check server/app.mjs && node --check server/db.mjs && node --check server/index.mjs && node --check server/community.mjs && node --check server/beta.mjs && node --check scripts/moderation.mjs",
    "mobile:android": "node scripts/mobile.mjs android",
    "mobile:ios": "node scripts/mobile.mjs ios",
    "mobile:sync": "cap sync"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "vite": "8.3.4"
  }
}
