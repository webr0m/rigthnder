{
  "appId": "com.rigthnder.app",
  "appName": "OnlyFachos",
  "webDir": "dist",
  "backgroundColor": "#111111",
  "ios": {
    "contentInset": "never",
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/browser",
      "@aparajita/capacitor-secure-storage",
      "@capacitor-community/admob"
    ]
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "contain",
      "hidden": false
    }
  },
  "android": {
    "allowMixedContent": false,
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/browser",
      "@aparajita/capacitor-secure-storage",
      "@capacitor-community/admob",
      "@capacitor/push-notifications"
    ]
  }
}
