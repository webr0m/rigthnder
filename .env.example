PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_PATH=./data/rigthnder.sqlite
DEMO_ENABLED=true
# Origen exacto de tu servidor. Añade tus URLs separadas por comas.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost,capacitor://localhost
TRUST_PROXY=0
# Google: cliente OAuth de tipo Aplicación web. El secreto se queda en Node.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
PUBLIC_URL=http://localhost:3000
# Recuperación: configura un transporte y un remitente de tu dominio.
# Namecheap/cPanel: MAIL_TRANSPORT=sendmail y SENDMAIL_PATH=/usr/sbin/sendmail.
# Alternativa: MAIL_TRANSPORT=smtp con TLS (465 o STARTTLS en 587).
MAIL_TRANSPORT=
MAIL_FROM=
SENDMAIL_PATH=/usr/sbin/sendmail
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Producción: redirección web del dominio anterior. API anterior disponible para clientes móviles.
CANONICAL_HOST=
LEGACY_HOST=
# Móvil: URL HTTPS pública del mismo backend Node (sin / al final).
VITE_API_URL=
# AdMob: por defecto activo en compilaciones nativas, con anuncios de prueba.
# La web nunca muestra anuncios. Usa false para generar un build sin SDK ni anuncios.
VITE_ADMOB_ENABLED=true
VITE_ADMOB_TEST_MODE=true
# App IDs de AdMob (usan ~). Los valores mostrados son los de prueba de Google.
VITE_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
VITE_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
VITE_ADMOB_ANDROID_BANNER_ID=ca-app-pub-3940256099942544/6300978111
VITE_ADMOB_IOS_BANNER_ID=ca-app-pub-3940256099942544/2934735716
# Push web: genera las claves una sola vez en el servidor privado.
# WEB_PUSH_PRIVATE_KEY y las credenciales FCM nunca llevan prefijo VITE_.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@webrom.cc
# JSON privado de la cuenta de servicio con permiso cloudmessaging.messages.create.
FCM_CREDENTIALS_PATH=
